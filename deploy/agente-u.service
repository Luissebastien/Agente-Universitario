; Agente U scheduler - systemd unit for a single-tenant Linux VPS.
;
; systemd is used ONLY to start, supervise and restart the process. It makes
; no scheduling decision: the 6-hour interval, the startup reconciling sync,
; the dependency chain and the retries all stay inside the process, which is
; what .ai/SCHEDULER-MVP-RULES.md requires (no external scheduler).
;
; Install: see docs/deployment.md. Paths assume
;   /opt/agente-u        code + virtualenv (read-only to the service)
;   /etc/agente-u        scheduler.toml + env file (read-only to the service)
;   /var/lib/agente-u    database, originals, OCR model cache (read-write)

[Unit]
Description=Agente U academic scheduler
Documentation=https://github.com/Luissebastien/Agente-Universitario
; Only outbound HTTPS is ever needed, but DNS must resolve at startup: the
; first thing the process does is a full Moodle sync.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agente-u
Group=agente-u
WorkingDirectory=/opt/agente-u

; Credentials only: MOODLE_URL and MOODLE_TOKEN, plus TELEGRAM_BOT_TOKEN and
; TELEGRAM_CHAT_ID when notifications go to Telegram (both or neither - with
; only one the process still starts and falls back to the log channel).
; Must be chmod 600, owned by root, and never inside /opt/agente-u (which is
; a git checkout).
EnvironmentFile=/etc/agente-u/env

; Keep the docTR model weights inside the state directory instead of the
; service user's home, so they survive and stay with the rest of the data.
Environment=DOCTR_CACHE_DIR=/var/lib/agente-u/doctr-cache
; 2 OCPU: let PyTorch use both, but do not let it oversubscribe them.
Environment=OMP_NUM_THREADS=2
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/agente-u/.venv/bin/python -m scheduler --config /etc/agente-u/scheduler.toml

Restart=always
RestartSec=60
; SIGTERM is honoured between items and, during a long OCR, between pages,
; so a clean stop takes about one page - not one document.
KillSignal=SIGTERM
TimeoutStopSec=120

; ---- data location and permissions -------------------------------------
; Creates/owns /var/lib/agente-u. 0700 + umask 0077 keep the academic
; database and the downloaded originals unreadable to other local users;
; the application itself sets no permissions of its own.
StateDirectory=agente-u
StateDirectoryMode=0700
UMask=0077

; ---- resource ceiling ---------------------------------------------------
; Per-item limits live in the code (download size, image pixels, rendered
; pixels per page, zip members). This is only the backstop, sized for a
; 2 GiB host (AWS t4g.small): measured worst case per document is ~1.3 GB,
; of which ~1 GB is the resident OCR model.
; The OCR model is released after each extraction run (see ExtractionJob),
; so this is a peak-of-the-moment ceiling, not a steady-state one: the
; daemon idles at ~150 MB and only approaches these figures while a cycle
; is actually doing OCR.
; Under cgroup v2 these push the process into swap rather than killing it,
; so the ceiling protects the OS without aborting a long extraction.
; On a larger host, raise both to roughly 70% / 85% of RAM.
MemoryHigh=1400M
MemoryMax=1700M
; 2 burstable vCPUs: leave headroom for the OS and the SSM agent, and avoid
; pegging both cores (which burns CPU credits fastest).
CPUQuota=150%

; ---- hardening ----------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
; Outbound TCP/IP only. No inbound socket is ever opened.
RestrictAddressFamilies=AF_INET AF_INET6
; The process has no legitimate reason to reach link-local addresses. On a
; cloud host that range serves instance metadata (169.254.169.254), which is
; where an SSRF would go looking for credentials. The Moodle client already
; rejects any host but the configured one; this is the second lock.
IPAddressDeny=169.254.0.0/16
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
; MemoryDenyWriteExecute is deliberately NOT set: PyTorch maps executable
; pages and would fail to load with it enabled.

[Install]
WantedBy=multi-user.target
